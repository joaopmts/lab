# OPCIONAL. O lab sobe sem .env: o docker-compose.yml tem padrões de LAB para tudo.
# Crie um .env só se quiser trocar valores:   copy .env.example .env   (Linux/macOS: cp)
# Variável vazia ou ausente = usa o padrão do compose.
# ATENÇÃO: os padrões são públicos. Troque-os se a máquina não for só sua/local.

# --- Airflow ---
# No Linux, use o seu UID (id -u) para os arquivos em airflow/logs e airflow/data não ficarem com root
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# --- Postgres (só vale na primeira subida, quando o banco é criado) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
HIVE_DB_PASSWORD=password

# --- MinIO ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin

# Credenciais S3A usadas por Spark, Airflow, Hive Metastore, Trino e NiFi.
# Podem ser as mesmas do root ou uma access key criada no console do MinIO.
S3A_ACCESS_KEY=admin
S3A_SECRET_KEY=minioadmin

# --- Kafka UI ---
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=kafkaadmin

# --- NiFi (senha com no mínimo 12 caracteres) ---
NIFI_USERNAME=nifi
NIFI_PASSWORD=nifiadmin1234!@
# Criptografa as propriedades sensíveis do flow (mín. 12 caracteres).
# NÃO troque numa instalação existente sem usar: nifi.sh set-sensitive-properties-key
NIFI_SENSITIVE_PROPS_KEY=
