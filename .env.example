# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env NÃO é versionado.

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_GID=0
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(16))"
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# --- Postgres ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
HIVE_DB_PASSWORD=password

# --- MinIO ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin

# Credenciais S3A usadas por Spark, Airflow, Hive Metastore e Trino.
# Podem ser as mesmas do root ou uma access key criada no console do MinIO.
S3A_ACCESS_KEY=admin
S3A_SECRET_KEY=minioadmin

# --- Kafka UI ---
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=kafkaadmin

# --- NiFi (senha com no mínimo 12 caracteres) ---
NIFI_USERNAME=nifi
NIFI_PASSWORD=nifiadmin1234!@
# Chave que criptografa propriedades sensíveis do flow (mín. 12 caracteres).
# Gere com:  python -c "import secrets; print(secrets.token_hex(16))"
NIFI_SENSITIVE_PROPS_KEY=
